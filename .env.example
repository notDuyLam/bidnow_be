# Application Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
# Option 1: Use individual database connection parameters
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=bidnow_db
DB_SSL=false

# Option 2: Use database URL (comment out the above if using this)
# DATABASE_URL=postgresql://username:password@localhost:5432/bidnow_db

# JWT Configuration (if you plan to add authentication)
JWT_SECRET=your_very_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DESTINATION=./uploads

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@bidnow.com

# Redis Configuration (for caching/sessions if needed)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auction Configuration
DEFAULT_AUCTION_DURATION=7
MIN_BID_INCREMENT=1.00
MAX_AUCTION_DURATION=30

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=./logs

# API Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
